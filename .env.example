# =============================================================================
#  POS backend settings. Copy this file to ".env" and fill it in.
#  The .env file holds secrets — it is ignored by git. Never share it.
# =============================================================================

# ---- Database ----
# One database. Each store keeps its data on its own drive: PostgreSQL's
# data_directory points at that drive's mount path (e.g. E:/pos-data), so
# whichever drive PostgreSQL is running from is the store you see.
# Use the SAME address for every drive — only the drive changes.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pos"

# ---- First-time store details (used only by "npm run seed" on a new drive) ----
# After that, change the name, address and taxes on the Settings screen.
STORE_NAME="Champion"
TAX_NAME="NY Sales Tax"
TAX_RATE=8.875

# ---- Security ----
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# ---- First login (created on each drive by "npm run seed") ----
OWNER_NAME="Owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""

# ---- Worker login (creates estimates and sees the approvals list only) ----
# Set here, not on the Settings screen. The server applies these every time it
# starts: change the password here and restart to change it; delete these lines
# and restart to switch the worker login off.
WORKER_NAME="Shop Worker"
WORKER_EMAIL=""
WORKER_PASSWORD=""

# ---- Server ----
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
