# =============================================================================
#  POS backend settings. Copy this file to ".env" and fill it in.
#  The .env file holds secrets — it is ignored by git. Never share it.
# =============================================================================

# ---- Two stores = two separate PostgreSQL databases ----
# Create them once in PostgreSQL:  CREATE DATABASE pos_store_a;  CREATE DATABASE pos_store_b;
STORE_A_NAME="Store A"
DATABASE_URL_STORE_A="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pos_store_a"
STORE_B_NAME="Store B"
DATABASE_URL_STORE_B="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pos_store_b"

# Prisma's command-line tools use DATABASE_URL. Point it at Store A.
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/pos_store_a"

# ---- Sales tax per store (used the first time you run "npm run seed") ----
STORE_A_TAX_NAME="NY Sales Tax"
STORE_A_TAX_RATE=8.875
STORE_B_TAX_NAME="Sales Tax"
STORE_B_TAX_RATE=6.625

# ---- Security ----
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# ---- First login (created in BOTH stores by "npm run seed") ----
OWNER_NAME="Owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""

# ---- Server ----
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
